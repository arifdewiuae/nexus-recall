# ── Demo mode ───────────────────────────────────────────────────────────────
# When 'true', the server falls back to the keys below if a request carries no
# user keys (the "Try it" path). Keep 'false' in production — users bring their
# own keys via Settings. The flag and the keys it gates must be set together.
DEMO_KEYS_ENABLED=false

# ── LLM providers ────────────────────────────────────────────────────────────
# Fireworks.ai — default provider for RAG answers (streaming LLM).
# Get your key at https://fireworks.ai (free tier available).
FIREWORKS_API_KEY=fw_...

# Anthropic — optional alternative LLM provider (Claude).
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — optional, for cloud embeddings (text-embedding-3-small).
# Usually supplied client-side via the Settings panel (own-key) instead.
OPENAI_API_KEY=sk-...

# ── Model overrides (optional) ───────────────────────────────────────────────
# Rotate models without a code change. Defaults live in chat.models.ts.
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash
# ANTHROPIC_MODEL=claude-sonnet-4-6
